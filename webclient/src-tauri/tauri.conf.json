{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZJMUD",
  "version": "0.1.0",
  "identifier": "com.zjmud.webclient",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "windows": [
      {
        "title": "ZJMUD",
        "width": 1180,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "theme": "Dark",
        "label": "main"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset: http://asset.localhost; connect-src 'self' ipc: http://ipc.localhost"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}